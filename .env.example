# minutes-cli 用の API キー。コピーして .env として保存する（.env は .gitignore 済み）。
# 読み込み順: 環境変数 > カレントディレクトリの .env > パッケージルートの .env
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# 要約の既定は Codex のログインを使用するため API キー不要。
# Anthropic API を明示的に選ぶ場合だけ設定する。
ANTHROPIC_API_KEY=
# scripts/build-app.sh / build-cli.sh の署名 ID（security find-identity -v -p codesigning に出る名前）。空なら ad-hoc 署名。
# 固定 ID で署名すると TCC の許可がビルドをまたいで残る。例: "Apple Development: <Apple ID> (<ID>)"
CODESIGN_IDENTITY=
# 配布用（scripts/release.sh）。Developer ID Application の証明書の名前（security find-identity -v -p codesigning に出る名前）。
# 例: "Developer ID Application: <会社名> (<チーム ID>)"
DEVELOPER_ID_IDENTITY=
# 公証のキーチェーンのプロファイル名（xcrun notarytool store-credentials <名前> --apple-id <Apple ID> --team-id <チーム ID> で作る）
NOTARY_PROFILE=
